{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "src/.*/__tests__/int/.*\\.int\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@generated/(.*)$": "<rootDir>/generated/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
