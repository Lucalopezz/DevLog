@startuml DevLogUseCases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor Visitante
actor "Usuário autenticado" as AuthUser
Visitante <|-- AuthUser

rectangle "API DevLog" {
