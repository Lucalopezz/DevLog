  package "Tags" {
    usecase "Criar tag" as UC07
    usecase "Pesquisar tags" as UC08
    usecase "Excluir tag" as UC09
  }

  package "Projetos" {
    usecase "Criar projeto" as UC10
    usecase "Pesquisar projetos" as UC11
    usecase "Consultar projeto" as UC12
    usecase "Pesquisar registros\ndo projeto" as UC13
    usecase "Atualizar projeto" as UC14
    usecase "Arquivar projeto" as UC15
    usecase "Restaurar projeto" as UC16
    usecase "Excluir projeto" as UC17
