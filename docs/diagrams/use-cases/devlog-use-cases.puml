@startuml DevLogUseCases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor Guest
actor "Authenticated user" as AuthUser
Guest <|-- AuthUser

rectangle "DevLog API" {
  package "Account and authentication" {
    usecase "Register user" as UC01
    usecase "Authenticate user" as UC02
    usecase "End session" as UC03
    usecase "View profile" as UC04
    usecase "Update profile" as UC05
    usecase "Change password" as UC06
  }

  package "Tags" {
    usecase "Create tag" as UC07
    usecase "Search tags" as UC08
    usecase "Delete tag" as UC09
  }

  package "Projects" {
    usecase "Create project" as UC10
    usecase "Search projects" as UC11
    usecase "Get project" as UC12
    usecase "Search project\nentries" as UC13
    usecase "Update project" as UC14
    usecase "Archive project" as UC15
    usecase "Restore project" as UC16
    usecase "Delete project" as UC17
  }

  package "Project details" {
    usecase "Add technology" as UC18
    usecase "Remove technology" as UC19
    usecase "Add command" as UC20
    usecase "Search commands" as UC21
    usecase "Get command" as UC22
    usecase "Update command" as UC23
    usecase "Remove command" as UC24
    usecase "Add resource" as UC25
    usecase "Search resources" as UC26
    usecase "Get resource" as UC27
    usecase "Update resource" as UC28
    usecase "Remove resource" as UC29
    usecase "Create environment" as UC44
    usecase "List project environments" as UC45
    usecase "Search owned environments" as UC46
    usecase "Update environment" as UC47
    usecase "Remove environment" as UC48
  }

  package "Technical journal" {
    usecase "Create technical entry" as UC30
    usecase "Search entries" as UC31
    usecase "Get entry" as UC32
    usecase "Update entry" as UC33
    usecase "Resolve issue" as UC34
    usecase "Reopen issue" as UC35
    usecase "Archive entry" as UC36
    usecase "Delete entry" as UC37
    usecase "Assign tag" as UC38
    usecase "Remove tag" as UC39
    usecase "Add attempt" as UC40
    usecase "List attempts" as UC41
    usecase "Update attempt" as UC42
    usecase "Remove attempt" as UC43
  }
}

Guest -- UC01
Guest -- UC02
Guest -- UC03

AuthUser -- UC04
AuthUser -- UC05
AuthUser -- UC06
AuthUser -- UC07
AuthUser -- UC08
AuthUser -- UC09
AuthUser -- UC10
AuthUser -- UC11
AuthUser -- UC12
AuthUser -- UC13
AuthUser -- UC14
AuthUser -- UC15
AuthUser -- UC16
AuthUser -- UC17
AuthUser -- UC18
AuthUser -- UC19
AuthUser -- UC20
AuthUser -- UC21
AuthUser -- UC22
AuthUser -- UC23
AuthUser -- UC24
AuthUser -- UC25
AuthUser -- UC26
AuthUser -- UC27
AuthUser -- UC28
AuthUser -- UC29
AuthUser -- UC30
AuthUser -- UC31
AuthUser -- UC32
AuthUser -- UC33
AuthUser -- UC34
AuthUser -- UC35
AuthUser -- UC36
AuthUser -- UC37
AuthUser -- UC38
AuthUser -- UC39
AuthUser -- UC40
AuthUser -- UC41
AuthUser -- UC42
AuthUser -- UC43
AuthUser -- UC44
AuthUser -- UC45
AuthUser -- UC46
AuthUser -- UC47
AuthUser -- UC48

note bottom of UC34
  Only ISSUE entries in the OPEN state.
end note
note bottom of UC40
  Only unarchived ISSUE entries.
end note
note bottom of UC14
  Archived projects are read-only.
end note

@enduml
