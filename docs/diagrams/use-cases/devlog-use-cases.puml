    usecase "Criar registro técnico" as UC30
    usecase "Pesquisar registros" as UC31
    usecase "Consultar registro" as UC32
    usecase "Atualizar registro" as UC33
    usecase "Resolver problema" as UC34
    usecase "Reabrir problema" as UC35
    usecase "Arquivar registro" as UC36
    usecase "Excluir registro" as UC37
